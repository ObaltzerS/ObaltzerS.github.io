---
// =============================================================================
// COMPONENT: About (Astro)
// -----------------------------------------------------------------------------
// Simple static bio block. id="about" lets the header nav link (#about) scroll here.
// Override the text from the page: <About bio="Your bio here." />
// =============================================================================

interface Props {
  bio?: string;
}

const {
  bio = "I am a recent grad passionate about using software to solve real-world problems. I have a history of well-designed and implemented tools, which are catalogued here on my page!",
} = Astro.props;
---

<section id="about" class="section about">
  <div class="container">
    {/* .section-title is defined in global.css for consistent headings */}
    <h2 class="section-title">About</h2>
    <div class="card">
      <p class="muted">{bio}</p>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 2rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.5rem 1.75rem;
    max-width: 42rem;
  }

  .card p {
    margin: 0;
    font-size: 1.05rem;
  }
</style>
